#!/usr/bin/env php
<?php

declare(strict_types=1);

$root = dirname(__DIR__);
if (is_file($root . '/vendor/autoload.php')) {
    require $root . '/vendor/autoload.php';
} else {
    spl_autoload_register(static function (string $class) use ($root): void {
        $prefix = 'XtScript\\';
        if (!str_starts_with($class, $prefix)) return;
        $path = $root . '/src/' . str_replace('\\', '/', substr($class, strlen($prefix))) . '.php';
        if (is_file($path)) require $path;
    });
}

use XtScript\Engine;
use XtScript\EngineOptions;
use XtScript\ExecutionBackend;
use XtScript\Formatter\CodeFormatter;
use XtScript\Loader\FilesystemLoader;

$usage = static function (): never {
    fwrite(STDERR, <<<'TXT'
XtScript CLI

Usage:
  xtscript lint <root>
  xtscript deps <root> <template>
  xtscript inspect <root> <template>
  xtscript compile <root> <cache-dir>
  xtscript warmup <root> <cache-dir>
  xtscript benchmark <root> <template> [iterations]
  xtscript beautify <html|css|js> <file> [--write]
  xtscript minify <css|js> <file> [--write]

Template files are not required to use any particular extension.
TXT);
    exit(2);
};

$command = $argv[1] ?? null;
if ($command === null || in_array($command, ['-h', '--help', 'help'], true)) $usage();

$files = static function (string $directory): array {
    $directory = realpath($directory) ?: $directory;
    if (!is_dir($directory)) throw new RuntimeException(sprintf('Directory "%s" does not exist.', $directory));
    $result = [];
    $iterator = new RecursiveIteratorIterator(new RecursiveDirectoryIterator($directory, FilesystemIterator::SKIP_DOTS));
    foreach ($iterator as $file) {
        if (!$file instanceof SplFileInfo || !$file->isFile()) continue;
        $path = $file->getPathname();
        $relative = ltrim(str_replace('\\', '/', substr($path, strlen($directory))), '/');
        if ($relative !== '' && !str_starts_with(basename($relative), '.')) $result[] = $relative;
    }
    sort($result, SORT_STRING);
    return $result;
};

try {
    if (in_array($command, ['beautify', 'minify'], true)) {
        $language = strtolower($argv[2] ?? '');
        $file = $argv[3] ?? '';
        if ($file === '' || !is_file($file)) $usage();
        $source = file_get_contents($file);
        if ($source === false) throw new RuntimeException(sprintf('Unable to read "%s".', $file));
        $output = match ([$command, $language]) {
            ['beautify', 'html'] => CodeFormatter::beautifyHtml($source),
            ['beautify', 'css'] => CodeFormatter::beautifyCss($source),
            ['beautify', 'js'] => CodeFormatter::beautifyJs($source),
            ['minify', 'css'] => CodeFormatter::minifyCss($source),
            ['minify', 'js'] => CodeFormatter::minifyJs($source),
            default => throw new InvalidArgumentException(sprintf('Unsupported formatter operation %s/%s.', $command, $language)),
        };
        if (in_array('--write', $argv, true)) {
            if (file_put_contents($file, $output . "\n") === false) throw new RuntimeException(sprintf('Unable to write "%s".', $file));
        } else {
            fwrite(STDOUT, $output . "\n");
        }
        exit(0);
    }

    $templateRoot = $argv[2] ?? '';
    if ($templateRoot === '') $usage();
    $loader = new FilesystemLoader($templateRoot);

    if ($command === 'lint') {
        $engine = new Engine($loader, new EngineOptions(executionBackend: ExecutionBackend::Evaluator));
        $count = 0;
        foreach ($files($templateRoot) as $name) {
            $engine->compileTemplate($name);
            ++$count;
        }
        fwrite(STDOUT, sprintf("OK: %d templates parsed.\n", $count));
        exit(0);
    }

    if (in_array($command, ['compile', 'warmup'], true)) {
        $cache = $argv[3] ?? '';
        if ($cache === '') $usage();
        $engine = new Engine($loader, new EngineOptions(executionBackend: ExecutionBackend::PhpFile, phpFileCacheDirectory: $cache));
        $templates = $files($templateRoot);
        $engine->warmup($templates);
        fwrite(STDOUT, sprintf("OK: %d templates warmed; PHP-eligible templates were persisted to %s.\n", count($templates), $cache));
        exit(0);
    }

    $name = $argv[3] ?? '';
    if ($name === '') $usage();
    $engine = new Engine($loader, new EngineOptions(executionBackend: ExecutionBackend::Evaluator));
    if ($command === 'deps') {
        $graph = $engine->dependencies($name, true);
        foreach ($graph->all() as $template => $dependencies) {
            fwrite(STDOUT, $template . ': ' . ($dependencies === [] ? '-' : implode(', ', $dependencies)) . "\n");
        }
        exit(0);
    }
    if ($command === 'inspect') {
        $program = $engine->compileTemplate($name);
        $graph = $engine->dependencies($name, true);
        fwrite(STDOUT, "template: {$name}\n");
        fwrite(STDOUT, 'instructions: ' . count($program->instructions) . "\n");
        fwrite(STDOUT, 'dependencies: ' . implode(', ', $graph->transitiveDependenciesOf($name)) . "\n");
        exit(0);
    }
    if ($command === 'benchmark') {
        $iterations = max(1, (int) ($argv[4] ?? 100));
        $engine = new Engine($loader, new EngineOptions(executionBackend: ExecutionBackend::Auto));
        $engine->render($name);
        $started = hrtime(true);
        for ($i = 0; $i < $iterations; ++$i) $engine->render($name);
        $seconds = (hrtime(true) - $started) / 1_000_000_000;
        fwrite(STDOUT, sprintf("%d renders in %.6fs (%.1f renders/s)\n", $iterations, $seconds, $iterations / max($seconds, 0.000000001)));
        exit(0);
    }

    $usage();
} catch (Throwable $exception) {
    fwrite(STDERR, $exception::class . ': ' . $exception->getMessage() . "\n");
    exit(1);
}
